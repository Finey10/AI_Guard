# Timezone policy: All timestamps are treated as UTC internally.
# Clients may submit ISO 8601 with offset; the backend normalises to UTC.
APP_ENV=development
LOG_LEVEL=info
DATA_DIR=./data

# ==============================================================================
# AI Advisor Configuration (Zero Latency ReleaseGuard AI)
# ==============================================================================
# The AI Advisor module explains the deterministic backend risk decision,
# extracts main contributing factors, and recommends actionable mitigations.
#
# LLM Provider: 'auto' (default: checks GEMINI then OPENAI), 'gemini', 'openai', or 'fallback'
RELEASEGUARD_LLM_PROVIDER=auto

# Optional model name overrides:
# For Gemini: gemini-2.5-flash (default), gemini-1.5-flash, gemini-1.5-pro
# For OpenAI: gpt-4o-mini (default), gpt-4o
# RELEASEGUARD_LLM_MODEL=gemini-2.5-flash

# API Keys (Never commit real keys to source control):
# Set at least one if you wish to use live LLM generation; otherwise the system
# automatically and safely falls back to the deterministic heuristic advisor.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
