# ReleaseGuard AI Agents — Environment Configuration
# Backend risk engine URL (default: http://localhost:8000)
BACKEND_API_URL=http://localhost:8000

# LLM Provider: 'auto', 'gemini', 'openai', or 'fallback'
RELEASEGUARD_LLM_PROVIDER=auto

# Optional API Keys for Live LLM Mode
# If omitted, the AI Agents run via deterministic high-precision rule fallback
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
