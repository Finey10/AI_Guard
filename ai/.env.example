# ReleaseGuard AI Agents — Environment Configuration
# Backend risk engine URL (default: http://localhost:8000)
BACKEND_API_URL=http://localhost:8000

# LLM Provider: 'auto', 'groq', 'gemini', 'openai', or 'fallback'
RELEASEGUARD_LLM_PROVIDER=auto

# Optional API Keys for Live LLM Mode
# Groq (Ultra-fast, Llama 3.3 70B):
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini:
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
